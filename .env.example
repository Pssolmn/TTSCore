# This worker deployment's own private configuration. Fill it with the same
# customer database/R2 values used by its corresponding API; never copy a
# developer's .env into a customer environment or commit this file as .env.
DATABASE_URL=postgresql://postgres:CHANGE_ME@127.0.0.1:5432/novelnova_db

# Cloudflare R2 S3 API. The worker uploads only completed, immutable episode audio.
R2_ENDPOINT_URL=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=CHANGE_ME
R2_SECRET_ACCESS_KEY=CHANGE_ME
R2_BUCKET_NAME=CHANGE_ME
R2_PUBLIC_URL=https://media.example.com

# Legacy single-narrator source retained for voice-design tooling. Reader renders
# use the three stable Basic-tier slots under assets/voices/Basic/ instead.
TTS_MASTER_VOICE_PATH=assets/master-voice/readji-narrator.wav
# Root folder for both the Basic-tier render voices (assets/voices/Basic/Basic_<slot>.wav,
# read on every render) and the dynamic per-character voice-variant scan
# (Settings dialog's "Variant Tray"). Subfolders other than Basic are Pro
# categories such as handsome_male/, little_female/, extra_male/, and
# extra_female/, with files named {folder_name}_{n}.wav inside. A missing
# category falls back only by its _male/_female suffix.
TTS_VOICE_VARIANTS_PATH=assets/voices
TTS_MODEL_ID=openbmb/VoxCPM2
TTS_DEVICE=cuda
TTS_LOAD_DENOISER=false
TTS_OPTIMIZE=false
TTS_INFERENCE_TIMESTEPS=10
TTS_CFG_VALUE=2.0
TTS_BADCASE_MAX_ATTEMPTS=2
TTS_MAX_CHUNK_CHARS=240
# Absolute safety cap: an over-limit job is failed before model/GPU/file work.
# This value can be lowered locally, but code refuses a value above 500.
TTS_MAX_OUTPUT_BLOCKS=500
TTS_POLL_SECONDS=5
TTS_LEASE_SECONDS=1800
TTS_WORKER_ID=readji-tts-local-1
TTS_WORK_DIR=runtime
# Keep false for a local DB. Set true only in the worker environment that is
# intentionally allowed to claim a remote DB's jobs (for example Railway).
TTS_CONFIRM_REMOTE=false
# Local durable record for the 6 GB R2-upload guard. It starts at 0 bytes when
# first created and does not count existing bucket data. This default is fine
# for normal installs; set another mounted path only when intentionally sharing
# one quota record across workers.
# TTS_R2_UPLOAD_QUOTA_STATE_PATH=runtime/r2-upload-quota.json
# Absolute path is preferred for Windows services. `ffmpeg` also works when it is in PATH.
TTS_FFMPEG_PATH=ffmpeg
# Published narration: mono MP3. MP3 has no PCM bit-depth; the temporary
# 16-bit WAV is deleted before upload. 32 kHz / 32 kbps is the compact default.
TTS_OUTPUT_SAMPLE_RATE=32000
TTS_OUTPUT_MP3_BITRATE_KBPS=32
# Safety interlock for Tier 1. Leave false while filling Pro voice folders;
# a Pro job is never synthesized unless this is explicitly changed to true.
TTS_PRO_RENDER_ENABLED=false
